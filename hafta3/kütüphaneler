import random
tutulan_sayi = random.randint(1, 100)
while True:
    tahmin = int(input("1-100 arasında tahmininizi girin: "))
    if tahmin < tutulan_sayi:
        print("Yukarı çık")
    elif tahmin > tutulan_sayi:
        print("Aşağı in")
    else:
        print("Tebrikler! Doğru tahmin ettiniz.")
        break


from datetime import datetime
giris = input("Sınav tarih ve saatini girin (GG.AA.YYYY SS:DD): ")
sinav_tarihi=datetime.strptime(giris, "%d.%m.%Y %H:%M")
su_an=datetime.now()
kalan_zaman = sinav_tarihi - su_an
gun = kalan_zaman.days
saat = kalan_zaman.seconds // 3600
print(f"Sınava {gun} gün ve {saat} saat kaldı.")